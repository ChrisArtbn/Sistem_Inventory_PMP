        return;
    }

    InventoryItem data;

    printf("Masukkan id: ");
    scanf("%s", data.id);

    Node* tempbarang = NULL;
    searchNode(*head, data.id, &tempbarang);//dari fungsi linklist
    if(tempbarang != NULL){
        printf("Barang duplikat");
        return;
    }

    printf("Masukkan nama barang: ");
