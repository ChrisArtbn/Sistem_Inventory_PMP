void cariBarang(Node* head){
    char tempid[50];
    printf("Masukkan id: ");
    scanf("%s", tempid);

    Node* tempor = NULL;
    searchNode(head, tempid, &tempor);//dari fungsi linklist

    if(tempor != NULL){
        printf("Barang ditemukan\n");
        tampilkanDetailBarang(tempor);
    }
    else{
        printf("Barang tidak ditemukan\n");
    }
}

void updateStok(Node* head){
    char tempid[50];
    printf("Masukkan id barang");
    scanf("%s", tempid);

    Node* tempor = NULL;
    searchNode(head, tempid, &tempor);//dari fungsi linkedlist

    if(tempor != NULL){
        printf("Status sekarang : %d\n", tempor->data.stok);
        
        int tempangka;
        printf("Mau berubah berapa banyak? ");
        scanf("%d", &tempangka);

        int pilihan;
        printf("Ketik 1 jika ingin (menambah) dan 2 jika ingin (mengurangi).\n");
        scanf("%d", &pilihan);

        if(pilihan == 1){
            tempor->data.stok += tempangka;
            printf("Stok telah ditambahkan\n");
            if(tempor->data.stok > 0 && tempor->data.status == 'H'){
                tempor->data.status = 'T';
            }
        }
        else if(pilihan == 2){
            if(tempangka > tempor->data.stok){
                printf("Jumlah melebihi stok saat ini\n");
            }
            else{
                tempor->data.stok -= tempangka;
                printf("Stok berhasil dikurangi\n");

                if(tempor->data.stok == 0){
                    tempor->data.status = 'H';
                }
            }
        }
        else{
            printf("ID tidak ada dalam inventory\n");
        }
    }
}

void updateStatus(Node* head){
    if(head == NULL){
        printf("Inventory Kosong\n");
        return;
    }

    char tempid[50];
    printf("Masukkan id barang");
    scanf("%s", tempid);

    Node* tempor = NULL;
    searchNode(head, tempid, &tempor);

    if(tempor != NULL){
        char newstats;
        printf("Status saat ini adalah: %c\n", tempor->data.status);
        printf("Pilih status (T=tersedia, D=dipinjam, R=rusak, H=kosong)");
        scanf(" %c", &newstats);

        if (newstats == 'T' || newstats == 'D' || newstats == 'R' || newstats == 'H'){
            tempor->data.status = newstats;
            printf("Status berhasil diperbarui\n");
        }
        else{
            printf("Status tidak valid\n");
        }

    }
    else{
        printf("Barang tidak ditemukan\n");
    }
}

void tampilkanData(Node* head){
    if(head == NULL){
        printf("Inventory Kosong");\
        return;
    }

    Node* current = head;
    int i = 1;

    while(current != NULL){
        printf("Item ke-%d ", i);
        tampilkanDetailBarang(current);//fungsi dari file lain
        current = current->next;
        i++;
    }
}

void ringkasan(Node* head){
    if(head == NULL){
        printf("Data kosong\n");
        return;
    }

    int countkategori = 0;
    int countstattersedia = 0;
    int countstatdipinjam = 0;
    int countstathabis = 0;
    int countstatrusak = 0;

    Node* current = head;

    while(current != NULL){
        countkategori++;

        if(current->data.status == 'T'){
            countstattersedia++;
        }
        else if(current->data.status == 'H'){
            countstathabis++;
        }
        else if(current->data.status == 'D'){
            countstatdipinjam++;
        }
        else if(current->data.status == 'R'){
            countstatrusak++;
        }
        current = current->next;
    }

    printf("Ringkasan Inventaris\n");
    printf("Total Kategori: %d\n", countkategori);
    printf("Jumlah Tersedia: %d\n", countstattersedia);
    printf("Jumlah Dipinjam: %d\n", countstatdipinjam);
    printf("Jumlah Rusak: %d\n", countstatrusak);
    printf("Jumlah Habis: %d\n", countstathabis);
}
