void cekMemori(int* memo);//buat cek siapa tau udah penuh


void tambahBarang(Node** head){
    int sisaMem;
    cekMemori(&sisaMem);

    if(sisaMem < 50){
        printf("Memori penuh\n");
        return;
    }

    InventoryItem data;

    printf("Masukkan id: ");
    scanf("%s", data.id);

    Node* tempbarang = NULL;
    searchNode(*head, data.id, &tempbarang);//dari fungsi linklist
    if(tempbarang != NULL){
        printf("Barang duplikat\n");
        return;
    }

    printf("Masukkan nama barang: ");
    scanf(" %[^\n]", data.nama);

    printf("Masukkan Lokasi: ");
    scanf(" %[^\n]", data.lokasi);

    printf("Masukkan Kategori: ");
    scanf(" %[^\n]", data.kategori);

    printf("Masukkan Jumlah Stok: ");
    printf("%d", &data.stok);

    printf("Masukkan Nama Pemilik: ");
    scanf(" %[^\n]", data.pemilik);

    printf("Masukkan Nama PIC: ");
    scanf(" %[^\n]", data.pic);

    if(data.stok > 0){
        data.status = 'T';
    }
    else{
        data.status = 'H';
    }

    addNode(head, data);//dari fungsi linklist

    printf("Barang berhasil dimasukkan\n");
}

